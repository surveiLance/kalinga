# Safe to expose in the browser. Find these in Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enable only after guest migrations and the updated gabay-chat are deployed.
NEXT_PUBLIC_GUEST_ACCESS_ENABLED=false
# Public Cloudflare Turnstile site key; secret key belongs in Supabase Auth settings.
# Auth CAPTCHA applies to sign-in/signup too; all login forms pass this token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Keep GROQ_API_KEY out of this file. Store it as a Supabase Edge Function secret:
# supabase secrets set GROQ_API_KEY=your_key
